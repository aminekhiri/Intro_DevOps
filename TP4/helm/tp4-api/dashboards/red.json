{
  "title": "TP4 API - RED (__NS__)",
  "uid": "tp4-red-__NS__",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries", "title": "Rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [{ "expr": "sum by (route) (rate(http_requests_total{namespace=\"__NS__\"}[1m]))", "legendFormat": "{{route}}" }]
    },
    {
      "type": "timeseries", "title": "Errors (% 5xx)",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "sum(rate(http_requests_total{namespace=\"__NS__\",status=~\"5..\"}[1m])) / sum(rate(http_requests_total{namespace=\"__NS__\"}[1m]))", "legendFormat": "erreurs" }]
    },
    {
      "type": "timeseries", "title": "Duration (p50 / p95)",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"__NS__\"}[1m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"__NS__\"}[1m])))", "legendFormat": "p95" }
      ]
    }
  ]
}
