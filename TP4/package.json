    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.2"
  }
